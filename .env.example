# Database
DATABASE_URL=postgresql://vekinbox:vekinbox@localhost:5432/vekinbox

# Redis (workers / queues)
REDIS_URL=redis://localhost:6379

# Session signing (web auth)
SESSION_SECRET=change-me-to-a-long-random-string

# API
PORT=3001
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# Web
WEB_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001/v1

# Docker bootstrap — seed demo data on first start
EMPTY_DB=true

# OAuth (SaaS / optional self-host)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (self-host SMTP — use mailcatcher in docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vekinbox.local

# Slack (self-host bring-your-own)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Sentry (optional)
SENTRY_DSN=
